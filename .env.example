# KAYA PTS - Environment Configuration
# Copy this file to .env and replace every placeholder with a unique secret.
FLASK_ENV=development
SECRET_KEY=replace_with_a_64_character_random_secret
API_KEY=replace_with_a_separate_random_api_key
# Scopes: personnel:read, personnel:write, personnel:salary (maas),
# personnel:personal (dogum_tarihi, ek_bilgi), stats:read
API_KEY_SCOPES=personnel:read,personnel:write,personnel:salary,personnel:personal,stats:read
# Optional JSON map for scoped key rotation. Keep its key values secret.
# Example: a directory integration that must not see salaries or birth dates.
# API_KEYS_JSON={"directory":{"key":"replace_me","scopes":["personnel:read"]}}

# Local development database. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///database.db
POSTGRES_USER=kaya_pts
POSTGRES_PASSWORD=replace_with_a_long_unique_database_password
POSTGRES_DB=kaya_pts

# Set to 1 behind one reverse proxy (Render, Nginx, a load balancer). If it
# stays 0 there, every visitor shares the proxy's IP: one person's failed
# logins lock everyone out and rate limits are shared by all users.
TRUSTED_PROXY_COUNT=0
# memory:// is per gunicorn worker; use a shared store in production,
# e.g. redis://redis:6379/0 (requires the "redis" package).
RATELIMIT_STORAGE_URI=memory://
# Retention for `flask purge-logs` (audit logs hold names and IP addresses).
LOG_RETENTION_DAYS=365
LOGIN_ATTEMPT_RETENTION_DAYS=30
MAX_CONTENT_LENGTH=16777216
MAX_IMAGE_PIXELS=20000000
MAX_API_PAGE_SIZE=100
